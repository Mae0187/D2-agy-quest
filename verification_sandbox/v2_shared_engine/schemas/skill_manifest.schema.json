{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "D2StandardSkillManifest",
  "description": "Diablo II 通用技能動畫與投射物標準資料規範",
  "type": "object",
  "required": ["skillId", "name", "category", "template", "timing", "layers"],
  "properties": {
    "skillId": { "type": "string", "description": "技能數字 ID 或英文字首標籤" },
    "name": { "type": "string", "description": "技能官方名稱" },
    "category": { "type": "string", "enum": ["fire", "cold", "lightning", "magic", "poison", "physical"] },
    "template": {
      "type": "string",
      "enum": ["linear_missile", "continuous_stream", "ground_hazard", "timed_multistage", "composite_minion"]
    },
    "timing": {
      "type": "object",
      "required": ["stepHz", "tickMs"],
      "properties": {
        "stepHz": { "type": "integer", "default": 25, "description": "邏輯物理鎖頻 (原廠標準 25Hz)" },
        "tickMs": { "type": "integer", "default": 40, "description": "每步長毫秒數 (1000/25 = 40ms)" },
        "durationTicks": { "type": "integer", "description": "技能存在週期數" },
        "releaseFrame": { "type": "integer", "description": "施法或出招脫手幀 (AnimData.D2)" }
      }
    },
    "parameters": {
      "type": "object",
      "properties": {
        "velocity": { "type": "number", "description": "初速度 (Missiles.txt Vel)" },
        "range": { "type": "number", "description": "射程週期 (Missiles.txt Range)" },
        "aoeRadius": { "type": "number", "description": "爆炸範圍半徑 px" },
        "subMissileId": { "type": "string", "description": "子投射物 ID (如火球爆炸、海蛇吐火彈)" }
      }
    },
    "direction": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "enum": [1, 4, 8, 16, 32], "description": "方向數" },
        "rowAngles": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "[DCC行號, 螢幕角度]"
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layerId", "atlasFile", "cellW", "cellH", "pivotX", "pivotY", "frames", "dirs"],
        "properties": {
          "layerId": { "type": "string" },
          "role": { "type": "string", "enum": ["projectile", "indicator", "falling_body", "falling_tail", "impact_burst", "ground_fire", "minion_body", "minion_attack", "predraw_glow", "predraw_flame"] },
          "atlasFile": { "type": "string" },
          "cellW": { "type": "integer" },
          "cellH": { "type": "integer" },
          "pivotX": { "type": "integer" },
          "pivotY": { "type": "integer" },
          "frames": { "type": "integer" },
          "dirs": { "type": "integer" },
          "blendMode": { "type": "string", "enum": ["normal", "lighter"], "default": "lighter" },
          "alpha": { "type": "number", "default": 1.0 },
          "preDraw": { "type": "integer", "enum": [0, 1], "description": "0: 前景包覆, 1: 背景襯底 (Overlay.txt)" },
          "offset": {
            "type": "object",
            "properties": {
              "x": { "type": "number", "default": 0 },
              "y": { "type": "number", "default": 0 }
            }
          }
        }
      }
    }
  }
}
